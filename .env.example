DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=

# ─── AMI Connections ─────────────────────────────────────────────────────────
# Mỗi PBX Asterisk cần một bộ 4 biến với suffix số (01, 02, 03, ...).
# Thêm PBX thứ 2 bằng cách copy block _01 và đổi thành _02, v.v.
# App sẽ báo lỗi và dừng nếu không tìm thấy ít nhất một bộ hợp lệ.

AMI_HOST_01=
AMI_PORT_01=5038
AMI_USER_01=
AMI_PASS_01=
AMI_ALIAS_01=

# AMI_HOST_02=
# AMI_PORT_02=5038
# AMI_USER_02=
# AMI_PASS_02=
# AMI_ALIAS_02=

SOCKET_PORT=

# ─── Runtime Config ─────────────────────────────────────────────────────────
# Bắt buộc khai báo đủ. App sẽ dừng khi thiếu hoặc sai format.
RUNTIME_MAX_RETRY=3
RUNTIME_RETRY_DELAY_MS=1000
RUNTIME_SETTIMEOUT_MS=1000
LOG_ENABLED=true
